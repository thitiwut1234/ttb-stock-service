						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.productId) {",
									"    pm.collectionVariables.set(\"productId\", jsonData.data.productId.toString());",
									"    console.log(\"Saved new productId: \" + jsonData.data.productId);",
									"}"
								],
